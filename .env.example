# Mâke pay frontend configuration (all optional)
# Use the built-in mock services (true) or the HTTP adapters (false, not yet implemented).
NEXT_PUBLIC_USE_MOCKS=true
# Vector map style for MapLibre. Defaults to OpenFreeMap (no key required).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Future backend base URL (do NOT put secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=
