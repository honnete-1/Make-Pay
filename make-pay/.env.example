# Mâke pay configuration. Everything is optional: with no Google keys the app
# runs in demo mode (MapLibre map + approximate demo routes), clearly labelled.

# --- Google Maps Platform -------------------------------------------------
# Browser key for Maps JavaScript API + Places API (New).
# Restrict it in Google Cloud Console: HTTP referrers = your domains,
# API restrictions = Maps JavaScript API, Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map style id (Map Management). Defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-only key for the Routes API (used by /api/routes, TWO_WHEELER).
# Never prefix with NEXT_PUBLIC_. Restrict to the Routes API.
GOOGLE_ROUTES_API_KEY=

# --- Demo services --------------------------------------------------------
# Use the built-in mock fare/payment services (true) or HTTP adapters (false, not implemented).
NEXT_PUBLIC_USE_MOCKS=true
# Vector style for the MapLibre fallback map. Defaults to OpenFreeMap (no key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Future backend base URL (do NOT put secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=
